# Obrigatória em produção, com pelo menos 8 caracteres. Use uma senha longa.
# Em desenvolvimento, a senha padrão é "roomly". Trocar a senha desconecta os aparelhos.
ROOMLY_PASSWORD=

# Porta do servidor em produção (em desenvolvimento, é sempre 3001)
PORT=3001

# Pasta da conversa e das imagens. Em produção, precisa estar em um disco persistente.
# DATA_DIR=/data

# Opcional: troca o servidor STUN padrão
# STUN_URL=stun:stun.l.google.com:19302

# Recomendado em produção: sem TURN, redes restritivas não conseguem se conectar
# TURN_URL=turn:turn.exemplo.com:3478
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha
