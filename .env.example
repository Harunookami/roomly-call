# Porta do servidor em produção (em desenvolvimento, é sempre 3001)
PORT=3001

# Opcional: troca o servidor STUN padrão
# STUN_URL=stun:stun.l.google.com:19302

# Recomendado em produção: sem TURN, redes restritivas não conseguem se conectar
# TURN_URL=turn:turn.exemplo.com:3478
# TURN_USERNAME=usuario
# TURN_CREDENTIAL=senha
